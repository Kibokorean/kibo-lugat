rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function activeTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/teacherProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/teacherProfiles/$(request.auth.uid)).data.active == true;
    }
    match /teacherProfiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /users/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || activeTeacher();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }
    match /leaderboard/{uid} {
      // Public leaderboard: anyone can view ranking, but only each signed-in
      // user can create/update/delete their own leaderboard document.
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','displayName','photoURL','allCount','weekCount','updatedAt']);
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /kiboClasses/{classId} {
      allow create: if activeTeacher() && request.resource.data.teacherUid == request.auth.uid;
      allow read, update, delete: if activeTeacher() && resource.data.teacherUid == request.auth.uid;
    }
    match /kiboAssignments/{assignmentId} {
      allow create: if activeTeacher() && request.resource.data.teacherUid == request.auth.uid
        && exists(/databases/$(database)/documents/kiboClasses/$(request.resource.data.classId))
        && get(/databases/$(database)/documents/kiboClasses/$(request.resource.data.classId)).data.teacherUid == request.auth.uid;
      allow read, update, delete: if activeTeacher() && resource.data.teacherUid == request.auth.uid;
    }
  }
}