// Firebase Storage Rules ichida service firebase.storage { ... } blokining
// ichiga joylashtiring. Mavjud boshqa Storage qoidalarini saqlang.

function signedIn() {
  return request.auth != null;
}

function activeTeacher() {
  return signedIn()
    && firestore.exists(/databases/(default)/documents/teacherProfiles/$(request.auth.uid))
    && firestore.get(/databases/(default)/documents/teacherProfiles/$(request.auth.uid)).data.active == true;
}

match /dictations/{uid}/{fileName} {
  // O'quvchi o'z fayllarini, faol o'qituvchi esa barcha diktantlarni ko'ra oladi.
  allow read: if signedIn() && (request.auth.uid == uid || activeTeacher());

  // Faqat o'z papkasiga, belgilangan format/hajm va server kutadigan metadata bilan upload.
  allow create: if signedIn()
    && request.auth.uid == uid
    && fileName.matches('yonsei3-lesson-[0-9]+-[0-9]+\\.(jpg|png|webp)')
    && request.resource.size > 0
    && request.resource.size <= 2 * 1024 * 1024
    && request.resource.contentType.matches('image/(jpeg|png|webp)')
    && request.resource.metadata.ownerUid == request.auth.uid
    && request.resource.metadata.course == 'yonsei3'
    && request.resource.metadata.topic.matches('([1-9]|[12][0-9]|30)');

  // Faylni almashtirish/o'chirish mijozga berilmaydi. Har bir urinish yangi fayl yo'li oladi.
  allow update, delete: if false;
}
